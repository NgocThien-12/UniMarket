@model UniMarket.ViewModels.OrderDetailViewModel
@{
    ViewData["Title"] = "Chi tiết đơn hàng " + Model.Order.OrderNumber;
    var statusBadge = Model.Order.Status switch
    {
        OrderStatus.Pending => "<span style='background:#fef3c7; color:#92400e; padding:6px 12px; border-radius:6px; font-size:13px; font-weight:700;'>⏳ Chờ xác nhận</span>",
        OrderStatus.Confirmed => "<span style='background:#dbeafe; color:#1e40af; padding:6px 12px; border-radius:6px; font-size:13px; font-weight:700;'>✔ Đã xác nhận</span>",
        OrderStatus.Shipping => "<span style='background:#f3e8ff; color:#6b21a8; padding:6px 12px; border-radius:6px; font-size:13px; font-weight:700;'>🚚 Đang giao hàng</span>",
        OrderStatus.Completed => "<span style='background:#dcfce7; color:#166534; padding:6px 12px; border-radius:6px; font-size:13px; font-weight:700;'>🎉 Hoàn thành</span>",
        OrderStatus.Cancelled => "<span style='background:#fee2e2; color:#991b1b; padding:6px 12px; border-radius:6px; font-size:13px; font-weight:700;'>✕ Đã hủy</span>",
        _ => "—"
    };
}

<div class="container" style="padding: 40px 20px; max-width: 900px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:25px;">
        <div>
            <h1 style="font-size:24px; font-weight:800; color:#111827;">Chi tiết đơn hàng: @Model.Order.OrderNumber</h1>
            <p style="color:#6b7280; font-size:14px; margin-top:4px;">Đặt vào ngày @Model.Order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div>
            @Html.Raw(statusBadge)
        </div>
    </div>

    <!-- Thông tin giao hàng -->
    <div style="background:#fff; border-radius:12px; border:1px solid #e5e7eb; padding:24px; margin-bottom:25px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <h3 style="font-size:16px; font-weight:700; color:#111827; margin-bottom:12px; border-bottom:1px solid #e5e7eb; padding-bottom:8px;">
            📍 Địa chỉ nhận hàng
        </h3>
        <div style="font-size:14px; line-height:1.7; color:#374151;">
            <div><strong>Người nhận:</strong> @Model.Order.RecipientName</div>
            <div><strong>Số điện thoại:</strong> @Model.Order.PhoneNumber</div>
            <div><strong>Địa chỉ:</strong> @Model.Order.DeliveryAddress</div>
            @if (!string.IsNullOrEmpty(Model.Order.Notes))
            {
                <div><strong>Ghi chú:</strong> @Model.Order.Notes</div>
            }
            <div><strong>Hình thức thanh toán:</strong> @(Model.Order.PaymentMethod == 1 ? "Chuyển khoản ngân hàng" : "Tiền mặt khi nhận hàng (COD)")</div>
        </div>
    </div>

    <!-- Danh sách sản phẩm mua -->
    <div style="background:#fff; border-radius:12px; border:1px solid #e5e7eb; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.04); margin-bottom:25px;">
        <table style="width:100%; border-collapse:collapse; text-align:left;">
            <thead>
                <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb; font-size:13px; color:#4b5563;">
                    <th style="padding:14px 16px;">Sản phẩm</th>
                    <th style="padding:14px 16px;">Đơn giá</th>
                    <th style="padding:14px 16px; text-align:center;">Số lượng</th>
                    <th style="padding:14px 16px; text-align:right;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Order.Items)
                {
                    <tr style="border-bottom:1px solid #f3f4f6; font-size:14px;">
                        <td style="padding:14px 16px;">
                            <div style="display:flex; align-items:center; gap:12px;">
                                @if (!string.IsNullOrEmpty(item.ProductImageSnapshot))
                                {
                                    <img src="@item.ProductImageSnapshot" style="width:50px; height:50px; object-fit:cover; border-radius:6px;" alt="@item.ProductNameSnapshot" />
                                }
                                <div>
                                    <div style="font-weight:600; color:#111827;">@item.ProductNameSnapshot</div>
                                    @if (item.ProductId > 0)
                                    {
                                        <a asp-controller="CTMatHang" asp-action="IndexCT" asp-route-id="@item.ProductId" style="font-size:12px; color:var(--primary);">
                                            Xem lại sản phẩm
                                        </a>
                                    }
                                </div>
                            </div>
                        </td>
                        <td style="padding:14px 16px; font-weight:600;">@item.UnitPrice.ToString("N0") ₫</td>
                        <td style="padding:14px 16px; text-align:center;">@item.Quantity</td>
                        <td style="padding:14px 16px; text-align:right; font-weight:700; color:#dc2626;">
                            @item.Subtotal.ToString("N0") ₫
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="background:#fafafa; font-size:16px; font-weight:800;">
                    <td colspan="3" style="padding:14px 16px; text-align:right;">Tổng giá trị đơn hàng:</td>
                    <td style="padding:14px 16px; text-align:right; color:#dc2626;">
                        @Model.Order.TotalAmount.ToString("N0") ₫
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Nút hành động -->
    <div style="display:flex; justify-content:space-between; align-items:center;">
        <a asp-controller="Account" asp-action="MyOrders" class="btn btn-outline">
            ← Quay lại danh sách đơn hàng
        </a>

        @if (Model.CanCancel)
        {
            <form asp-controller="Order" asp-action="Cancel" asp-route-id="@Model.Order.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline" style="color:#dc2626; border-color:#fca5a5;">
                    ✕ Hủy đơn hàng này
                </button>
            </form>
        }
    </div>
</div>
