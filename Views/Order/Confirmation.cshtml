@model UniMarket.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container" style="padding: 60px 20px; max-width: 650px; text-align: center;">
    <div style="background:#fff; border-radius:12px; border:1px solid #bbf7d0; padding:45px 30px; box-shadow:0 8px 30px rgba(0,0,0,0.06);">
        <div style="font-size:64px; margin-bottom:12px;">🎉</div>
        <h1 style="font-size:26px; font-weight:800; color:#166534; margin-bottom:10px;">Đặt hàng thành công!</h1>
        <p style="color:#4b5563; font-size:15px; margin-bottom:24px;">
            Cảm ơn bạn đã tin dùng UniMarket. Đơn hàng của bạn đã được ghi nhận vào hệ thống.
        </p>

        <div style="background:#f9fafb; border-radius:10px; border:1px solid #e5e7eb; padding:20px; text-align:left; margin-bottom:25px; font-size:14px;">
            <div style="display:flex; justify-content:space-between; margin-bottom:10px; border-bottom:1px solid #e5e7eb; padding-bottom:8px;">
                <span style="color:#6b7280;">Mã đơn hàng:</span>
                <strong style="color:#1a56db; font-size:16px;">@Model.OrderNumber</strong>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                <span style="color:#6b7280;">Người nhận:</span>
                <strong>@Model.RecipientName (@Model.PhoneNumber)</strong>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                <span style="color:#6b7280;">Địa chỉ nhận hàng:</span>
                <span style="text-align:right; max-width:320px;">@Model.DeliveryAddress</span>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                <span style="color:#6b7280;">Phương thức thanh toán:</span>
                <span style="color:#16a34a; font-weight:600;">@Model.PaymentMethod</span>
            </div>
            <div style="display:flex; justify-content:space-between; border-top:1px solid #e5e7eb; padding-top:10px; font-size:16px; font-weight:800;">
                <span>Tổng số tiền:</span>
                <span style="color:#dc2626;">@Model.TotalAmount.ToString("N0") ₫</span>
            </div>
        </div>

        <div style="display:flex; gap:12px; justify-content:center;">
            <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary" style="padding:11px 22px; font-weight:700;">
                📋 Xem chi tiết đơn hàng
            </a>
            <a asp-controller="MatHang" asp-action="IndexMH" class="btn btn-outline" style="padding:11px 22px;">
                🛍️ Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>

