@model UniMarket.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container" style="padding: 40px 20px; max-width: 600px;">
    <div style="background:#fff; border-radius:12px; border:1px solid #e5e7eb; padding:30px; box-shadow:0 4px 15px rgba(0,0,0,0.05);">
        <h1 style="font-size:22px; font-weight:800; color:#111827; border-bottom:1px solid #e5e7eb; padding-bottom:15px; margin-bottom:25px;">
            🔑 Đổi mật khẩu
        </h1>

        <form asp-controller="Account" asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:15px; color:#dc2626;"></div>

            <div class="form-group" style="margin-bottom:18px;">
                <label asp-for="CurrentPassword" style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Mật khẩu hiện tại</label>
                <input asp-for="CurrentPassword" class="form-control" type="password" required />
                <span asp-validation-for="CurrentPassword" class="text-danger" style="color:#dc2626; font-size:12px;"></span>
            </div>

            <div class="form-group" style="margin-bottom:18px;">
                <label asp-for="NewPassword" style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Mật khẩu mới</label>
                <input asp-for="NewPassword" class="form-control" type="password" required />
                <span asp-validation-for="NewPassword" class="text-danger" style="color:#dc2626; font-size:12px;"></span>
            </div>

            <div class="form-group" style="margin-bottom:18px;">
                <label asp-for="ConfirmNewPassword" style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmNewPassword" class="form-control" type="password" required />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger" style="color:#dc2626; font-size:12px;"></span>
            </div>

            <div style="margin-top:25px; display:flex; justify-content:space-between; align-items:center;">
                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline">Quay lại</a>
                <button type="submit" class="btn btn-primary" style="padding:10px 24px; font-weight:700;">
                    Cập nhật mật khẩu
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

