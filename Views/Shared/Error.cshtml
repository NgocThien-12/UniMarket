@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="container" style="padding: 60px 20px; text-align: center; max-width: 650px;">
    <div style="background:#fff; border-radius:12px; border:1px solid #fee2e2; padding:40px; box-shadow:0 4px 15px rgba(0,0,0,0.05);">
        <div style="font-size:56px; margin-bottom:12px;">⚠️</div>
        <h1 style="font-size:24px; font-weight:800; color:#dc2626; margin-bottom:10px;">Đã xảy ra lỗi khi xử lý yêu cầu</h1>
        <p style="color:#6b7280; font-size:15px; margin-bottom:20px;">
            Hệ thống đã ghi nhận lỗi này. Vui lòng thử lại sau hoặc quay về trang chủ.
        </p>

        @if (Model.ShowRequestId)
        {
            <div style="font-size:13px; color:#9ca3af; margin-bottom:24px;">
                Mã yêu cầu (Request ID): <code>@Model.RequestId</code>
            </div>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary" style="padding:10px 24px;">
            🏠 Quay về Trang chủ
        </a>
    </div>
</div>
