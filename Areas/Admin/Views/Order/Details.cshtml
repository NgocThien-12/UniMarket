@model UniMarket.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.OrderNumber;
}

<div style="margin-bottom:20px;">
    <a asp-area="Admin" asp-controller="Order" asp-action="IndexGiaoDichAdmin" class="btn btn-outline" style="font-size:13px;">
        ← Quay lại danh sách đơn hàng
    </a>
</div>

<div style="background:#fff; border-radius:10px; border:1px solid #e5e7eb; padding:24px; margin-bottom:24px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #e5e7eb; padding-bottom:15px; margin-bottom:20px;">
        <div>
            <h2 style="font-size:20px; font-weight:800; color:#111827;">Mã đơn: @Model.OrderNumber</h2>
            <div style="font-size:13px; color:#6b7280; margin-top:4px;">Thời gian tạo: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <form asp-area="Admin" asp-controller="Order" asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" style="display:flex; gap:10px; align-items:center;">
            @Html.AntiForgeryToken()
            <span style="font-size:13px; font-weight:600;">Trạng thái:</span>
            <select name="newStatus" class="form-control" style="font-size:13px; padding:6px 12px; width:auto;">
                <option value="0" selected="@(Model.Status == OrderStatus.Pending)">Chờ xác nhận</option>
                <option value="1" selected="@(Model.Status == OrderStatus.Confirmed)">Đã xác nhận</option>
                <option value="2" selected="@(Model.Status == OrderStatus.Shipping)">Đang giao hàng</option>
                <option value="3" selected="@(Model.Status == OrderStatus.Completed)">Hoàn thành</option>
                <option value="4" selected="@(Model.Status == OrderStatus.Cancelled)">Hủy đơn</option>
            </select>
            <button type="submit" class="btn btn-primary" style="padding:6px 14px; font-size:13px;">Cập nhật</button>
        </form>
    </div>

    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; font-size:14px; margin-bottom:24px;">
        <div style="background:#f9fafb; padding:15px; border-radius:8px;">
            <h4 style="font-size:14px; font-weight:700; margin-bottom:8px; color:#111827;">Thông tin người đặt &amp; nhận</h4>
            <div><strong>Khách hàng:</strong> @Model.RecipientName</div>
            <div><strong>Điện thoại:</strong> @Model.PhoneNumber</div>
            <div><strong>Địa chỉ:</strong> @Model.DeliveryAddress</div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div><strong>Ghi chú:</strong> @Model.Notes</div>
            }
        </div>

        <div style="background:#f9fafb; padding:15px; border-radius:8px;">
            <h4 style="font-size:14px; font-weight:700; margin-bottom:8px; color:#111827;">Thanh toán &amp; Giao dịch</h4>
            <div><strong>Phương thức:</strong> @Model.PaymentMethod</div>
            <div><strong>Tổng tiền hàng:</strong> <span style="color:#dc2626; font-weight:700;">@Model.TotalAmount.ToString("N0") ₫</span></div>
            <div><strong>Cập nhật lần cuối:</strong> @Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>

    <h3 style="font-size:16px; font-weight:700; margin-bottom:12px; color:#111827;">Danh sách mặt hàng</h3>
    <table style="width:100%; border-collapse:collapse; font-size:13px;">
        <thead>
            <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6b7280; text-align:left;">
                <th style="padding:10px 12px;">Sản phẩm</th>
                <th style="padding:10px 12px;">Đơn giá</th>
                <th style="padding:10px 12px; text-align:center;">Số lượng</th>
                <th style="padding:10px 12px; text-align:right;">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr style="border-bottom:1px solid #f3f4f6;">
                    <td style="padding:10px 12px;">
                        <div style="display:flex; align-items:center; gap:10px;">
                            @if (!string.IsNullOrEmpty(item.ProductImageSnapshot))
                            {
                                <img src="@item.ProductImageSnapshot" style="width:40px; height:40px; object-fit:cover; border-radius:4px;" alt="" />
                            }
                            <div>
                                <div style="font-weight:600;">@item.ProductNameSnapshot</div>
                                @if (item.ProductId > 0)
                                {
                                    <div style="font-size:11px; color:#6b7280;">ID: #@item.ProductId</div>
                                }
                            </div>
                        </div>
                    </td>
                    <td style="padding:10px 12px;">@item.UnitPrice.ToString("N0") ₫</td>
                    <td style="padding:10px 12px; text-align:center;">@item.Quantity</td>
                    <td style="padding:10px 12px; text-align:right; font-weight:700; color:#dc2626;">@item.Subtotal.ToString("N0") ₫</td>
                </tr>
            }
        </tbody>
    </table>
</div>
