@model UniMarket.ViewModels.AdminOrderListViewModel
@{
    ViewData["Title"] = "Quản lý đơn giao dịch";
}

<div style="background:#fff; border-radius:10px; border:1px solid #e5e7eb; padding:20px; margin-bottom:24px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
    <form asp-area="Admin" asp-controller="Order" asp-action="IndexGiaoDichAdmin" method="get" style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <div style="flex:2; min-width:200px;">
            <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm theo mã đơn, người nhận, số điện thoại..." />
        </div>

        <div style="flex:1; min-width:160px;">
            <select name="Status" class="form-control" onchange="this.form.submit()">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="0" selected="@(Model.Status == OrderStatus.Pending)">⏳ Chờ xác nhận</option>
                <option value="1" selected="@(Model.Status == OrderStatus.Confirmed)">✔ Đã xác nhận</option>
                <option value="2" selected="@(Model.Status == OrderStatus.Shipping)">🚚 Đang giao hàng</option>
                <option value="3" selected="@(Model.Status == OrderStatus.Completed)">🎉 Hoàn thành</option>
                <option value="4" selected="@(Model.Status == OrderStatus.Cancelled)">✕ Đã hủy</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary" style="padding:9px 18px;">🔍 Tìm kiếm</button>
        <a asp-area="Admin" asp-controller="Order" asp-action="IndexGiaoDichAdmin" class="btn btn-outline" style="padding:9px 18px;">✕ Đặt lại</a>
    </form>
</div>

<div style="background:#fff; border-radius:10px; border:1px solid #e5e7eb; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
    <div style="padding:16px 20px; border-bottom:1px solid #e5e7eb; display:flex; justify-content:space-between; align-items:center;">
        <div style="font-weight:700; color:#111827;">Danh sách đơn hàng (@Model.TotalItems đơn)</div>
    </div>

    <div class="table-responsive">
        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:13px;">
            <thead>
                <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb; color:#4b5563;">
                    <th style="padding:12px 16px;">Mã đơn</th>
                    <th style="padding:12px 16px;">Khách hàng / Nhận hàng</th>
                    <th style="padding:12px 16px;">Số lượng món</th>
                    <th style="padding:12px 16px;">Tổng giá trị</th>
                    <th style="padding:12px 16px;">Ngày tạo</th>
                    <th style="padding:12px 16px;">Cập nhật trạng thái</th>
                    <th style="padding:12px 16px; text-align:right;">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Any())
                {
                    @foreach (var o in Model.Orders)
                    {
                        <tr style="border-bottom:1px solid #f3f4f6;">
                            <td style="padding:12px 16px; font-weight:700; color:#1a56db;">@o.OrderNumber</td>
                            <td style="padding:12px 16px;">
                                <div style="font-weight:600; color:#111827;">@o.RecipientName</div>
                                <div style="font-size:11px; color:#6b7280;">📞 @o.PhoneNumber • @o.DeliveryAddress</div>
                            </td>
                            <td style="padding:12px 16px; color:#4b5563;">@o.Items.Sum(i => i.Quantity) món</td>
                            <td style="padding:12px 16px; font-weight:700; color:#dc2626;">@o.TotalAmount.ToString("N0") ₫</td>
                            <td style="padding:12px 16px; color:#6b7280;">@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="padding:12px 16px;">
                                <form asp-area="Admin" asp-controller="Order" asp-action="UpdateStatus" asp-route-id="@o.Id" method="post" style="display:inline-block; margin:0;">
                                    @Html.AntiForgeryToken()
                                    <select name="newStatus" class="form-control" style="font-size:12px; padding:4px 8px; width:auto; display:inline-block;" onchange="this.form.submit()">
                                        <option value="0" selected="@(o.Status == OrderStatus.Pending)">Chờ xác nhận</option>
                                        <option value="1" selected="@(o.Status == OrderStatus.Confirmed)">Đã xác nhận</option>
                                        <option value="2" selected="@(o.Status == OrderStatus.Shipping)">Đang giao hàng</option>
                                        <option value="3" selected="@(o.Status == OrderStatus.Completed)">Hoàn thành</option>
                                        <option value="4" selected="@(o.Status == OrderStatus.Cancelled)">Hủy đơn</option>
                                    </select>
                                </form>
                            </td>
                            <td style="padding:12px 16px; text-align:right;">
                                <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@o.Id" class="btn btn-outline" style="padding:4px 10px; font-size:12px;">
                                    Xem
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="padding:40px; text-align:center; color:#6b7280;">
                            Không tìm thấy đơn hàng nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div style="padding:16px 20px; display:flex; justify-content:center; gap:6px;">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <a asp-area="Admin" asp-controller="Order" asp-action="IndexGiaoDichAdmin" 
                   asp-route-Page="@p" asp-route-Keyword="@Model.Keyword" asp-route-Status="@Model.Status"
                   class="btn @(p == Model.Page ? "btn-primary" : "btn-outline")" style="padding:5px 12px; font-size:13px;">
                    @p
                </a>
            }
        </div>
    }
</div>

