@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " – " : "")UniMarket Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .admin-alert {
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .admin-alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
        .admin-alert-error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
        .table-responsive { overflow-x: auto; }
        .badge-status { padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; display: inline-block; }
    </style>
</head>
<body>
    <div class="admin-wrap">

        <!-- ============================================================
             SIDEBAR
        ============================================================ -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-logo">
                <div class="sidebar-logo-icon">U</div>
                <div>
                    <div class="sidebar-logo-text">Uni<span>Market</span></div>
                </div>
                <span class="sidebar-badge">ADMIN</span>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Tổng quan</div>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="IndexAdmin" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <span class="nav-icon">🏠</span> Dashboard
                </a>

                <div class="nav-section-title">Quản lý sàn</div>
                <a asp-area="Admin" asp-controller="Product" asp-action="IndexSpAdmin" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")">
                    <span class="nav-icon">📦</span> Sản phẩm
                </a>
                <a asp-area="Admin" asp-controller="User" asp-action="IndexNguoiDungAdmin" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
                    <span class="nav-icon">👥</span> Người dùng
                </a>
                <a asp-area="Admin" asp-controller="Order" asp-action="IndexGiaoDichAdmin" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">
                    <span class="nav-icon">📋</span> Đơn giao dịch
                </a>
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                    <span class="nav-icon">🏷️</span> Danh mục
                </a>

                <div class="nav-section-title">Hệ thống</div>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-item" target="_blank">
                    <span class="nav-icon">🌐</span> Xem trang web chính
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="admin-user">
                    <div class="admin-avatar">A</div>
                    <div>
                        <div class="admin-name">@(user?.FullName ?? "Admin UniMarket")</div>
                        <div class="admin-role">Quản trị viên cấp cao</div>
                    </div>
                </div>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="margin-top:10px;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-logout" style="width:100%; text-align:left; border:none; background:none; cursor:pointer;">
                        🚪 Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <!-- ============================================================
             MAIN CONTENT
        ============================================================ -->
        <div class="main-content">
            <header class="top-header">
                <div class="top-header-left">
                    <button class="hamburger-admin" onclick="toggleSidebar()">☰</button>
                    <div class="page-title">@ViewData["Title"]</div>
                </div>
                <div class="top-header-right">
                    <span style="font-size:13px; color:#6b7280;">Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>
            </header>

            <div class="content-body" style="padding: 24px;">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="admin-alert admin-alert-success">
                        <span>✅ @TempData["SuccessMessage"]</span>
                        <button type="button" onclick="this.parentElement.remove()" style="background:none; border:none; cursor:pointer; font-weight:700;">✕</button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="admin-alert admin-alert-error">
                        <span>⚠️ @TempData["ErrorMessage"]</span>
                        <button type="button" onclick="this.parentElement.remove()" style="background:none; border:none; cursor:pointer; font-weight:700;">✕</button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>

    </div>

    <script>
        function toggleSidebar() {
            var sb = document.getElementById('sidebar');
            if (sb) sb.classList.toggle('open');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

