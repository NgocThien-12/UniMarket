@model List<UniMarket.Models.Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div style="display:grid; grid-template-columns: 2fr 1fr; gap:25px; align-items:start;">
    <!-- Bảng danh mục -->
    <div style="background:#fff; border-radius:10px; border:1px solid #e5e7eb; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <div style="padding:16px 20px; border-bottom:1px solid #e5e7eb; font-weight:700; color:#111827;">
            Danh sách danh mục đồ dùng (@Model.Count danh mục)
        </div>

        <table style="width:100%; border-collapse:collapse; font-size:13px; text-align:left;">
            <thead>
                <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6b7280;">
                    @* <th style="padding:12px 16px;">Icon</th> *@
                    <th style="padding:12px 16px;">Tên danh mục</th>
                    <th style="padding:12px 16px;">Slug</th>
                    <th style="padding:12px 16px;">Số sản phẩm</th>
                    <th style="padding:12px 16px; text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr style="border-bottom:1px solid #f3f4f6;">
                        @* <td style="padding:12px 16px; font-size:20px;">@(c.Icon ?? "📦")</td> *@
                        <td style="padding:12px 16px; font-weight:600; color:#111827;">
                            @c.Name
                            @if (!string.IsNullOrEmpty(c.Description))
                            {
                                <div style="font-size:11px; color:#6b7280; font-weight:400;">@c.Description</div>
                            }
                        </td>

                        <td style="padding:12px 16px; color:#6b7280;">@c.Slug</td>
                        <td style="padding:12px 16px; font-weight:700; color:#1a56db;">@c.Products.Count sản phẩm</td>
                        <td style="padding:12px 16px; text-align:right;">
                            <form asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline" style="padding:4px 8px; font-size:12px; color:#dc2626; border-color:#fca5a5;">
                                    Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Form thêm mới danh mục -->
    <div style="background:#fff; border-radius:10px; border:1px solid #e5e7eb; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <h3 style="font-size:16px; font-weight:700; color:#111827; margin-bottom:16px; border-bottom:1px solid #e5e7eb; padding-bottom:10px;">
            ＋ Thêm danh mục mới
        </h3>

        <form asp-area="Admin" asp-controller="Category" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group" style="margin-bottom:14px;">
                <label style="display:block; font-size:13px; font-weight:600; margin-bottom:5px;">Tên danh mục <span style="color:red;">*</span></label>
                <input type="text" name="Name" class="form-control" placeholder="VD: Dụng cụ thể thao" required />
            </div>

            <div class="form-group" style="margin-bottom:14px;">
                <label style="display:block; font-size:13px; font-weight:600; margin-bottom:5px;">Icon / Emoji</label>
                <input type="text" name="Icon" class="form-control" placeholder="VD: " maxlength="5" />
            </div>

            <div class="form-group" style="margin-bottom:14px;">
                <label style="display:block; font-size:13px; font-weight:600; margin-bottom:5px;">Số lượng (đường dẫn URL)</label>
                <input type="text" name="Slug" class="form-control" placeholder="VD: the-thao" />
            </div>

            <div class="form-group" style="margin-bottom:14px;">
                <label style="display:block; font-size:13px; font-weight:600; margin-bottom:5px;">Mô tả ngắn</label>
                <textarea name="Description" class="form-control" rows="2" placeholder="Mô tả các món đồ thuộc danh mục..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; padding:10px; font-weight:700;">
                Tạo danh mục
            </button>
        </form>
    </div>
</div>

