@model UniMarket.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển quản trị";
}

<div class="stats-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:20px; margin-bottom:30px;">
    <!-- Stat 1: Người dùng -->
    <div class="stat-card" style="background:#fff; padding:20px; border-radius:10px; border:1px solid #e5e7eb; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-size:13px; color:#6b7280; font-weight:600;">Tổng người dùng</div>
                <div style="font-size:28px; font-weight:800; color:#111827; margin-top:6px;">@Model.TotalUsers</div>
            </div>
            <div style="font-size:32px;">👥</div>
        </div>
        <div style="margin-top:12px; font-size:12px; color:#16a34a;">Sinh viên đăng ký</div>
    </div>

    <!-- Stat 2: Sản phẩm -->
    <div class="stat-card" style="background:#fff; padding:20px; border-radius:10px; border:1px solid #e5e7eb; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-size:13px; color:#6b7280; font-weight:600;">Tổng sản phẩm</div>
                <div style="font-size:28px; font-weight:800; color:#111827; margin-top:6px;">@Model.TotalProducts</div>
            </div>
            <div style="font-size:32px;">📦</div>
        </div>
        <div style="margin-top:12px; font-size:12px; color:#1a56db;">@Model.ApprovedProducts sản phẩm đang bán</div>
    </div>

    <!-- Stat 3: Chờ duyệt -->
    <div class="stat-card" style="background:#fff; padding:20px; border-radius:10px; border:1px solid #e5e7eb; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-size:13px; color:#6b7280; font-weight:600;">Tin chờ phê duyệt</div>
                <div style="font-size:28px; font-weight:800; color:#d97706; margin-top:6px;">@Model.PendingProducts</div>
            </div>
            <div style="font-size:32px;">⏳</div>
        </div>
        <div style="margin-top:12px; font-size:12px;">
            <a asp-area="Admin" asp-controller="Product" asp-action="IndexSpAdmin" asp-route-Status="0" style="color:#d97706; font-weight:600; text-decoration:underline;">
                Duyệt tin ngay →
            </a>
        </div>
    </div>

    <!-- Stat 4: Đơn hàng -->
    <div class="stat-card" style="background:#fff; padding:20px; border-radius:10px; border:1px solid #e5e7eb; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-size:13px; color:#6b7280; font-weight:600;">Tổng đơn giao dịch</div>
                <div style="font-size:28px; font-weight:800; color:#111827; margin-top:6px;">@Model.TotalOrders</div>
            </div>
            <div style="font-size:32px;">📋</div>
        </div>
        <div style="margin-top:12px; font-size:12px; color:#6b7280;">@Model.PendingOrders đơn chờ xác nhận</div>
    </div>

    <!-- Stat 5: Giá trị giao dịch -->
    <div class="stat-card" style="background:#fff; padding:20px; border-radius:10px; border:1px solid #e5e7eb; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-size:13px; color:#6b7280; font-weight:600;">Giá trị giao dịch</div>
                <div style="font-size:24px; font-weight:800; color:#dc2626; margin-top:6px;">@Model.TotalOrderValue.ToString("N0") ₫</div>
            </div>
            <div style="font-size:32px;">💰</div>
        </div>
        <div style="margin-top:12px; font-size:12px; color:#6b7280;">Tổng giá trị các đơn hợp lệ</div>
    </div>
</div>

<!-- Biểu đồ thống kê -->
<div style="background:#fff; padding:24px; border-radius:10px; border:1px solid #e5e7eb; margin-bottom:30px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
    <h3 style="font-size:16px; font-weight:700; margin-bottom:16px; color:#111827;">📊 Thống kê hoạt động sàn trao đổi UniMarket</h3>
    <div style="max-height:300px;">
        <canvas id="orderChart"></canvas>
    </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:25px;">
    <!-- Sản phẩm mới đăng gần đây -->
    <div style="background:#fff; border-radius:10px; border:1px solid #e5e7eb; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h3 style="font-size:16px; font-weight:700; color:#111827;">📦 Sản phẩm mới đăng</h3>
            <a asp-area="Admin" asp-controller="Product" asp-action="IndexSpAdmin" style="font-size:13px; color:var(--primary); font-weight:600;">Xem tất cả</a>
        </div>

        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="border-bottom:1px solid #e5e7eb; color:#6b7280; text-align:left;">
                        <th style="padding:8px 6px;">Sản phẩm</th>
                        <th style="padding:8px 6px;">Giá</th>
                        <th style="padding:8px 6px;">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.RecentProducts)
                    {
                        var status = p.Status switch
                        {
                            ProductStatus.Pending => "<span style='color:#d97706; font-weight:600;'>Chờ duyệt</span>",
                            ProductStatus.Approved => "<span style='color:#16a34a; font-weight:600;'>Đã duyệt</span>",
                            ProductStatus.Rejected => "<span style='color:#dc2626; font-weight:600;'>Từ chối</span>",
                            _ => "<span style='color:#6b7280;'>Ẩn/Đã bán</span>"
                        };

                        <tr style="border-bottom:1px solid #f3f4f6;">
                            <td style="padding:10px 6px; font-weight:600; max-width:180px; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">
                                @p.Name
                            </td>
                            <td style="padding:10px 6px; color:#dc2626; font-weight:700;">@p.Price.ToString("N0") ₫</td>
                            <td style="padding:10px 6px;">@Html.Raw(status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Đơn hàng gần đây -->
    <div style="background:#fff; border-radius:10px; border:1px solid #e5e7eb; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h3 style="font-size:16px; font-weight:700; color:#111827;">📋 Đơn giao dịch gần đây</h3>
            <a asp-area="Admin" asp-controller="Order" asp-action="IndexGiaoDichAdmin" style="font-size:13px; color:var(--primary); font-weight:600;">Xem tất cả</a>
        </div>

        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="border-bottom:1px solid #e5e7eb; color:#6b7280; text-align:left;">
                        <th style="padding:8px 6px;">Mã đơn</th>
                        <th style="padding:8px 6px;">Khách hàng</th>
                        <th style="padding:8px 6px;">Tổng tiền</th>
                        <th style="padding:8px 6px;">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        var ost = o.Status switch
                        {
                            OrderStatus.Pending => "<span style='color:#d97706; font-weight:600;'>Chờ duyệt</span>",
                            OrderStatus.Confirmed => "<span style='color:#1e40af; font-weight:600;'>Đã xác nhận</span>",
                            OrderStatus.Shipping => "<span style='color:#6b21a8; font-weight:600;'>Đang giao</span>",
                            OrderStatus.Completed => "<span style='color:#16a34a; font-weight:600;'>Hoàn thành</span>",
                            _ => "<span style='color:#dc2626;'>Đã hủy</span>"
                        };

                        <tr style="border-bottom:1px solid #f3f4f6;">
                            <td style="padding:10px 6px; font-weight:700; color:#1a56db;">@o.OrderNumber</td>
                            <td style="padding:10px 6px;">@o.RecipientName</td>
                            <td style="padding:10px 6px; font-weight:700; color:#dc2626;">@o.TotalAmount.ToString("N0") ₫</td>
                            <td style="padding:10px 6px;">@Html.Raw(ost)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('orderChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Tháng 5', 'Tháng 6', 'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10'],
                datasets: [
                    {
                        label: 'Số lượng đơn giao dịch',
                        data: [12, 19, 25, 32, 45, @Model.TotalOrders],
                        backgroundColor: 'rgba(26, 86, 219, 0.7)',
                        borderColor: 'rgb(26, 86, 219)',
                        borderWidth: 1
                    },
                    {
                        label: 'Sản phẩm mới đăng',
                        data: [18, 28, 40, 52, 68, @Model.TotalProducts],
                        backgroundColor: 'rgba(16, 185, 129, 0.7)',
                        borderColor: 'rgb(16, 185, 129)',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}

