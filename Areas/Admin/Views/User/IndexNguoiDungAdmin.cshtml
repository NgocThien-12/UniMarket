@model UniMarket.ViewModels.AdminUserListViewModel
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div style="background:#fff; border-radius:10px; border:1px solid #e5e7eb; padding:20px; margin-bottom:24px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
    <form asp-area="Admin" asp-controller="User" asp-action="IndexNguoiDungAdmin" method="get" style="display:flex; gap:12px; align-items:center;">
        <div style="flex:1;">
            <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm theo tên, email, số điện thoại sinh viên..." />
        </div>
        <button type="submit" class="btn btn-primary" style="padding:9px 18px;">🔍 Tìm kiếm</button>
        <a asp-area="Admin" asp-controller="User" asp-action="IndexNguoiDungAdmin" class="btn btn-outline" style="padding:9px 18px;">✕ Đặt lại</a>
    </form>
</div>

<div style="background:#fff; border-radius:10px; border:1px solid #e5e7eb; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
    <div style="padding:16px 20px; border-bottom:1px solid #e5e7eb; display:flex; justify-content:space-between; align-items:center;">
        <div style="font-weight:700; color:#111827;">Danh sách tài khoản sinh viên (@Model.TotalItems thành viên)</div>
    </div>

    <div class="table-responsive">
        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:13px;">
            <thead>
                <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb; color:#4b5563;">
                    <th style="padding:12px 16px;">Họ và tên</th>
                    <th style="padding:12px 16px;">Email</th>
                    <th style="padding:12px 16px;">Số điện thoại</th>
                    <th style="padding:12px 16px;">Vai trò</th>
                    <th style="padding:12px 16px;">Ngày tham gia</th>
                    <th style="padding:12px 16px;">Trạng thái</th>
                    <th style="padding:12px 16px; text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var u in Model.Users)
                    {
                        var role = Model.UserRoles.ContainsKey(u.Id) ? Model.UserRoles[u.Id] : "User";
                        var roleBadge = role.Contains("Admin") 
                            ? "<span style='background:#fee2e2; color:#991b1b; padding:3px 8px; border-radius:4px; font-weight:700;'>Admin</span>"
                            : "<span style='background:#eff6ff; color:#1e40af; padding:3px 8px; border-radius:4px; font-weight:600;'>Sinh viên</span>";

                        var statusBadge = u.IsActive
                            ? "<span class='badge-status' style='background:#dcfce7; color:#166534;'>Hoạt động</span>"
                            : "<span class='badge-status' style='background:#fee2e2; color:#991b1b;'>Đã khóa</span>";

                        <tr style="border-bottom:1px solid #f3f4f6;">
                            <td style="padding:12px 16px; font-weight:600; color:#111827;">@u.FullName</td>
                            <td style="padding:12px 16px; color:#4b5563;">@u.Email</td>
                            <td style="padding:12px 16px; color:#4b5563;">@(u.PhoneNumber ?? "—")</td>
                            <td style="padding:12px 16px;">@Html.Raw(roleBadge)</td>
                            <td style="padding:12px 16px; color:#6b7280;">@u.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td style="padding:12px 16px;">@Html.Raw(statusBadge)</td>
                            <td style="padding:12px 16px; text-align:right;">
                                <form asp-area="Admin" asp-controller="User" asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn thay đổi trạng thái tài khoản này?');">
                                    @Html.AntiForgeryToken()
                                    @if (u.IsActive)
                                    {
                                        <button type="submit" class="btn btn-outline" style="padding:4px 10px; font-size:12px; color:#dc2626; border-color:#fca5a5;">
                                            🔒 Khóa tài khoản
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary" style="padding:4px 10px; font-size:12px; background:#16a34a; border-color:#16a34a;">
                                            🔓 Mở khóa
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="padding:40px; text-align:center; color:#6b7280;">
                            Không tìm thấy người dùng nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div style="padding:16px 20px; display:flex; justify-content:center; gap:6px;">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <a asp-area="Admin" asp-controller="User" asp-action="IndexNguoiDungAdmin" 
                   asp-route-Page="@p" asp-route-Keyword="@Model.Keyword"
                   class="btn @(p == Model.Page ? "btn-primary" : "btn-outline")" style="padding:5px 12px; font-size:13px;">
                    @p
                </a>
            }
        </div>
    }
</div>

